<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CXRMSamples">
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".activities.settings.SettingsActivity"
            android:exported="false"
            android:label="服务器设置"
            android:theme="@style/Theme.CXRMSamples" />
        <activity
            android:name=".activities.psopDemo.PsopDemoActivity"
            android:exported="false"
            android:label="PSOP Demo"
            android:theme="@style/Theme.CXRMSamples" />
        <activity
            android:name=".activities.ttsAndNotification.TTSAndNotificationActivity"
            android:exported="false"
            android:label="@string/title_activity_ttsand_notification"
            android:theme="@style/Theme.CXRMSamples" />
        <activity
            android:name=".activities.useTranslation.TranslationSceneActivity"
            android:exported="false"
            android:label="@string/title_activity_translation_scene"
            android:theme="@style/Theme.CXRMSamples" />
        <activity
            android:name=".activities.useTeleprompter.TeleprompterSceneActivity"
            android:exported="false"
            android:label="@string/title_activity_teleprompter_scene"
            android:theme="@style/Theme.CXRMSamples" />
        <activity
            android:name=".activities.useAIScene.AISceneActivity"
            android:exported="false"
            android:label="@string/title_activity_aiscene"
            android:theme="@style/Theme.CXRMSamples" />
        <activity
            android:name=".activities.customProtocol.CustomProtocolActivity"
            android:exported="false"
            android:label="@string/title_activity_custom_protocol"
            android:theme="@style/Theme.CXRMSamples" />
        <activity
            android:name=".activities.customView.CustomViewActivity"
            android:exported="false"
            android:label="@string/title_activity_custom_viewctivity"
            android:theme="@style/Theme.CXRMSamples" />
        <activity
            android:name=".activities.video.VideoActivity"
            android:exported="false"
            android:label="@string/title_activity_video"
            android:theme="@style/Theme.CXRMSamples" />
        <activity
            android:name=".activities.liveVideo.LiveVideoActivity"
            android:exported="false"
            android:label="@string/title_activity_live_video"
            android:theme="@style/Theme.CXRMSamples" />
        <activity
            android:name=".activities.mediaFile.MediaFileActivity"
            android:exported="false"
            android:label="@string/title_activity_media_file"
            android:theme="@style/Theme.CXRMSamples" />
        <activity
            android:name=".activities.picture.PictureActivity"
            android:exported="false"
            android:label="@string/title_activity_picture"
            android:theme="@style/Theme.CXRMSamples" />
        <activity
            android:name=".activities.deviceInformation.DeviceInformationActivity"
            android:exported="false"
            android:label="@string/title_activity_device_information"
            android:theme="@style/Theme.CXRMSamples" />
        <activity
            android:name=".activities.audio.AudioUsageActivity"
            android:exported="false"
            android:label="@string/title_activity_audio_usage"
            android:theme="@style/Theme.CXRMSamples" />
        <activity
            android:name=".activities.usageSelection.UsageSelectionActivity"
            android:exported="false"
            android:label="@string/title_activity_usage_selection"
            android:theme="@style/Theme.CXRMSamples" />
        <activity
            android:name=".activities.bluetoothConnection.BluetoothInitActivity"
            android:exported="false"
            android:label="@string/title_activity_bluetooth_init"
            android:theme="@style/Theme.CXRMSamples" />
        <activity
            android:name=".activities.main.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.CXRMSamples">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>